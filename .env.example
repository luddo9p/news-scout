# Required
VPS_URL=http://localhost:3000
API_KEY=your_api_key_secret
RESEND_API_KEY=re_xxxxx
RESEND_TO=your@email.com

# Required (Docker)
OLLAMA_API_KEY=your_ollama_cloud_key
OLLAMA_CLOUD_URL=https://ollama.com

# Optional but recommended for the luxe agent: without it the experience search falls
# back to DuckDuckGo, which challenges automated requests after a few queries.
# Free key: https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Optional
RESEND_FROM=onboarding@resend.dev
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
APIFY_API_KEY=

# Unused right now: the Reddit source is unwired from both agents (403 from the
# VPS datacenter IP). Kept for a one-line re-wire; create a "script" app on
# https://www.reddit.com/prefs/apps if you ever do.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AgentScout/1.0 (veille bot)
